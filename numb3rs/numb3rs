import re
import sys


def main():
    print(validate(input("IPv4 Address: ")))


def validate(ip):
    match = re.search(r"^(\d+)\.(\d+)\.(\d+)\.(\d+)$", ip)

    if not match:
        return False

    numbers = match.groups()

    for number in numbers:
        if int(number) < 0 or int(number) > 255:
            return False

    return True


if __name__ == "__main__":
    main()
