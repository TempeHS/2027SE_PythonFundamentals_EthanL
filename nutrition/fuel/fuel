while True:
    try:
        fuel = input("fuel: ")
        x, y = fuel.split("/")

        x = int(x)
        y = int(y)

        percent = x / y * 100

        if percent > 99:
            print("F")
        elif percent < 1:
            print("E")
        else:
            print(f"{round(percent)}%")

        break

    except (ZeroDivisionError, ValueError):
        print("Try again")
        pass
