import sys
import random
from pyfiglet import Figlet

figlet = Figlet()

args = sys.argv[1:]

if len(args) == 0:
    font = random.choice(figlet.getFonts())
elif len(args) == 2:
    if args[0] not in ("-f", "--font"):
        sys.exit("Invalid usage")
    if args[1] not in figlet.getFonts():
        sys.exit("Invalid usage")
    figlet.setFont(font=args[1])
else:
    sys.exit("Invalid usage")

if len(args) == 0:
    figlet.setFont(font=font)

usint = input("Enter: ")
print(figlet.renderText(usint))
